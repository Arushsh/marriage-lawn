# ─────────────────────────────────────────────
# Django core
# ─────────────────────────────────────────────
DJANGO_SECRET_KEY='8bg=yubo2v+6$8pf*su7e!r+ky$5lq10ym&b3s3#q^4$mka%!v'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Local PostgreSQL example:
#   DATABASE_URL=postgresql://user:password@localhost:5432/marriage_lawn
# Neon / Supabase / Render: paste the connection string they give you.
DATABASE_URL=postgresql://user:password@localhost:5432/marriage_lawn

# ─────────────────────────────────────────────
# CORS – comma-separated list of allowed origins
# ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# Cloudinary (get values from cloudinary.com → Dashboard)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Or use the single URL form:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─────────────────────────────────────────────
# Email – default: Gmail SMTP with an App Password
# Steps: Google Account → Security → 2-Step Verification → App passwords
# ─────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password   # NOT your Gmail password

# ─── Alternative: Resend ─────────────────────────────────────────────────────
# 1. pip install resend
# 2. Uncomment the four lines below and comment out the Gmail block above.
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# ANYMAIL_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
# ─────────────────────────────────────────────────────────────────────────────

# Owner notification email (leads are sent here)
OWNER_NOTIFY_EMAIL=owner@example.com

# ─────────────────────────────────────────────
# reCAPTCHA v3 (optional – leave blank for MVP)
# ─────────────────────────────────────────────
RECAPTCHA_SECRET=
